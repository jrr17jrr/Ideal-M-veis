# =============================================================================
#  Variáveis de ambiente — COPIE para `.env.local` e preencha quando for ligar
#  o back-end. Nada aqui é necessário para rodar o front-end mockado hoje.
# =============================================================================

# URL pública do site (usada em metadata / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
#  Supabase (FUTURO) — ver src/lib/supabase/README.md e docs/backend-plan.md
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # SOMENTE no servidor — nunca no client

# ---------------------------------------------------------------------------
#  Mercado Pago (FUTURO) — ver src/app/api/payments/README.md
#  NUNCA prefixar com NEXT_PUBLIC_. Estas chaves só podem ser lidas no servidor.
# ---------------------------------------------------------------------------
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# NEXT_PUBLIC_MP_PUBLIC_KEY=        # chave PÚBLICA do MP (ok expor), p/ tokenizar cartão no client
